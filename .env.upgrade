# .env.upgrade
# Append these to your existing .env (or merge the values you want).
# Every one of these is an override of a src/config.py default, so you do
# NOT need to edit config.py for the model upgrades.

# ---------------------------------------------------------------- LLM
# Free tier, but 70B instead of 8B. Needs a key (still free to obtain).
GROQ_API_KEY=
RESOLUTION_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------- retrieval embedding
# MiniLM-L6  =  22M params, 384 dims
# bge-large  = 335M params, 1024 dims  <- big MTEB retrieval gain
# IMPORTANT: changing this changes the vector dimension, so you MUST
# rebuild the index:  python scripts/build_index.py
# ALSO: bge models expect an instruction prefix on the QUERY side only:
#   "Represent this sentence for searching relevant passages: " + query
# If you do not want to touch the query path, use the drop-in below
# instead (768 dims, no prefix needed, still a large upgrade on MiniLM):
#   EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ---------------------------------------------------- summarisation
# bart-large-cnn (406M) is already the strongest free CNN-style
# summariser; distilbart-cnn-12-6 (306M) is the distilled version.
SUMMARIZER_MODEL=facebook/bart-large-cnn

# ------------------------------------------------------ classifier
# Trained by finetune/train.py. deberta-v3-large needs CUDA; on Apple
# Silicon use roberta-large (see --preset mps-safe).
CLASSIFIER_BASE_MODEL=microsoft/deberta-v3-large
CLASSIFIER_FINETUNED_DIR=./finetune/artifacts/deberta-v3-large-tickets

# ------------------------------------------------------------- ASR
# whisper-small = 244M. large-v3-turbo = 809M with large-v3-class
# accuracy at roughly 8x the decoding speed of large-v3. Runs on MPS.
ASR_MODEL=openai/whisper-large-v3-turbo

# ------------------------------------------------------------- TTS
# Kokoro-82M is the best-sounding free English TTS in this size class;
# mms-tts-eng (VITS) stays as the zero-dependency fallback.
TTS_MODEL=hexgrad/Kokoro-82M

# Reset to the model default. The approved audio sample was EQ applied
# over DEFAULT-rate synthesis; 0.9 changes the timbre and breaks
# tests/test_tts_offline.py::test_default_knobs_do_not_alter_synthesis.
TTS_SPEAKING_RATE=1.0

# ------------------------------------------------------- fine-tuning
# 0 = use the FULL split (11,668 train rows / 2,060 eval rows).
FINETUNE_MAX_ROWS=0
FINETUNE_EPOCHS=3
