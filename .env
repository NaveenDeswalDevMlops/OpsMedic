# .env.example
# Copy to .env and fill in. Only GROQ_API_KEY is required for the
# resolution sub-task; everything else has working defaults.
# Get a free key at https://console.groq.com

GROQ_API_KEY=

# --- Branding (working title; rename here anytime) ---
PRODUCT_NAME=OpsMedic
PRODUCT_TAGLINE=GenAI Incident Copilot — diagnose, resolve, learn
ORG_NAME=Genpact

# --- Models (free/local defaults; override only if needed) ---
# RESOLUTION_MODEL=llama-3.1-8b-instant
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
# CLASSIFIER_BASE_MODEL=distilbert-base-uncased
# ASR_MODEL=openai/whisper-tiny
# TTS_MODEL=facebook/mms-tts-eng

# --- Retrieval ---
# TOP_K=3
# SIMILARITY_THRESHOLD=0.35

# --- LLMOps ---
# METRICS_DB_PATH=./data/llmops_metrics.db
# CACHE_DB_PATH=./data/llmops_cache.db
# CACHE_TTL_SECONDS=3600
# CACHE_ENABLED=1

# --- Dataset (Kaggle 47k IT tickets) ---
# KAGGLE_DATASET=adisongoh/it-service-ticket-classification-dataset
# KB_ROWS=0            # 0 = index all 47,837 tickets; set e.g. 5000 for quick runs
